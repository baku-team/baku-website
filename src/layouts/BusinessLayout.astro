---
import BaseLayout from './BaseLayout.astro';

interface Props {
  index: '01' | '02' | '03' | '04' | '05' | '06';
  kanji: string;
  chapter: string;
  enTitle: string;
  jaTitle: string;
  lead: string;
  /** the two parties 貘 stands between, e.g. ['権利者', '企業'] */
  bridge: [string, string];
  tone?: 'light' | 'ink';
  title: string;
  description: string;
}

const {
  index,
  kanji,
  chapter,
  enTitle,
  jaTitle,
  lead,
  bridge,
  tone = 'light',
  title,
  description,
} = Astro.props;

const TOTAL = 2; // 公開中の事業の数（2026-11-10 イベントを外した）（非表示の事業は pages/business/_hidden-*.astro）
const next = String(Math.min(TOTAL, Number(index) + 1)).padStart(2, '0');
const prev = String(Math.max(1, Number(index) - 1)).padStart(2, '0');
const hasNext = Number(index) < TOTAL;
const hasPrev = Number(index) > 1;
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/business/${index}/`}
  chrome={false}
>
  <a class="skip-link" href="#biz-detail">本文へスキップ</a>

  <header class="topbar">
    <a class="mark" href="/"><img src="/assets/logo_icon.jpg" alt="" width="30" height="30" />合同会社 貘</a>
    <nav aria-label="グローバルナビゲーション">
      <a href="/#business">事業</a>
      <a href="/#company">会社概要</a>
      <a href="/#contact">お問い合わせ</a>
    </nav>
  </header>

  <main>
    <!-- Sub-page hero banner -->
    <section class={`biz-hero ${tone}`} aria-labelledby="biz-detail-heading">
      <span class="anchor right"><a class="back-link" href="/#business">事業一覧へ</a></span>
      <div class="frame">
        <div class="content">
          <div class="reveal index">事業 {index}</div>
          <h1 class="reveal d1 ja-title ja-main" id="biz-detail-heading">{jaTitle}</h1>
          <p class="reveal d2 en-sub">{enTitle}</p>
          <p class="reveal d3 bridge"><span>{bridge[0]}</span><b>貘</b><span>{bridge[1]}</span></p>
          <p class="reveal d3 lead">{lead}</p>
        </div>
      </div>
    </section>

    <div class={`band-divider band-divider--${tone === 'light' ? 'ink' : 'paper'}`} aria-hidden="true">
      <span class="divider"><span>Detail</span></span>
    </div>

    <article id="biz-detail" class={`biz-detail ${tone === 'light' ? 'ink' : 'light'}`}>
      <slot />
    </article>

    <div class="band-divider band-divider--paper" aria-hidden="true">
      <span class="divider"><span>Index</span></span>
    </div>

    <nav class="biz-pager" aria-label="事業ページの遷移">
      {hasPrev ? (
        <a class="pager-link prev" href={`/business/${prev}/`}>
          <span class="pager-cap">前の事業</span>
          <span class="pager-label">— {prev} —</span>
        </a>
      ) : <span class="pager-spacer" />}
      <a class="pager-home" href="/#business">事業一覧へ戻る</a>
      {hasNext ? (
        <a class="pager-link next" href={`/business/${next}/`}>
          <span class="pager-cap">次の事業</span>
          <span class="pager-label">— {next} —</span>
        </a>
      ) : <span class="pager-spacer" />}
    </nav>
  </main>

  <footer>
    <div class="row">
      <div class="brand">
        貘
        <small>合同会社 貘</small>
      </div>
      <div class="col">
        <h6>サイト内</h6>
        <a href="/#business">事業</a>
        <a href="/#company">会社概要</a>
        <a href="/#contact">お問い合わせ</a>
        <a href="https://reverse-lp.pages.dev/">REVERSE 製品サイト ↗</a>
      </div>
      <div class="col">
        <h6>お問い合わせ</h6>
        <a href="mailto:baku@baku-llc.co.jp">baku@baku-llc.co.jp</a>
        <p class="muted">事業のご相談・取材のご依頼はこちらへ。</p>
      </div>
      <div class="col">
        <h6>所在地</h6>
        <p class="muted">〒140-0001<br />東京都品川区北品川四丁目11-8<br />春雨寺1階</p>
      </div>
    </div>
    <div class="copy">
      <span>© 2026 Baku LLC.</span>
      <span>法人番号 7010703008530</span>
    </div>
  </footer>

  <script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
  })();
  </script>
</BaseLayout>
