---
// 島の動物診療の絵（海の向こうの島へ通う小舟・月に瑞雲。Fable 作 2026-11-10）
// 部品ごとに動かすため SVG をそのまま埋め込む。雲・月・金の粒の動きは IP の絵と共通（.ip-svg）。
import raw from '../assets/island-wafu.svg?raw';
interface Props { width?: number }
const { width = 540 } = Astro.props;
const svg = raw
  .replace(/<svg\b([^>]*)>/, (_m: string, a: string) =>
    `<svg class="ip-svg island-svg" style="width:${width}px"${a.replace(/\s(width|height|class|style)="[^"]*"/g, '')}>`)
  // 舟の位置（transform 属性）を外側の組に移し、内側の #boat だけを揺らす（CSS の transform が位置を上書きしないように）
  .replace(/<g id="boat" transform="([^"]*)">/, '<g transform="$1"><g id="boat">')
  .replace('<g id="particles"', '</g><g id="particles"');
---
<Fragment set:html={svg} />
