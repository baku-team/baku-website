---
// 青海波（静止）。置き方：bottom＝区画の下端／straddle＝区画の境目をまたぐ／full＝区画の全面
interface Props { variant?: 'bottom' | 'straddle' | 'full' }
const { variant = 'bottom' } = Astro.props;
const rows: [number, number[]][] = [[-10, [20]], [0, [0, 40]], [10, [20]], [20, [0, 40]], [30, [20]]];
const rings = [20, 15, 10, 5];
const circles: { x: number; y: number; r: number }[] = [];
for (const [y, xs] of rows) for (const x of xs) for (const r of rings) circles.push({ x, y, r });
const id = 'seigaiha-' + Math.random().toString(36).slice(2, 8);
---
<div class={`waves ${variant === 'bottom' ? '' : variant}`} aria-hidden="true">
  <svg preserveAspectRatio="none">
    <defs>
      <pattern id={id} width="40" height="20" patternUnits="userSpaceOnUse">
        {circles.map((c) => <circle cx={c.x} cy={c.y} r={c.r} fill="#0E1A2B" stroke="currentColor" stroke-width=".8" />)}
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
</div>
