---
import { REVERSE_URL, SHOW_ISLAND } from '../config';
interface Props { current?: 'ip' | 'system' | 'island' | 'company' | 'contact' | null }
const { current = null } = Astro.props;
const items = [
  { key: 'system', href: '/business/02/', label: 'システム開発' },
  { key: 'ip', href: '/business/01/', label: 'IPライセンス' },
  { key: 'island', href: '/business/03/', label: '島の動物診療' },
  { key: 'company', href: '/company/', label: '会社概要' },
  { key: 'contact', href: '/contact/', label: 'お問い合わせ' },
].filter((i) => SHOW_ISLAND || i.key !== 'island');
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="合同会社 貘 トップへ">
      <img src="/assets/logo_icon.jpg" alt="" width="32" height="32" />
      <span>合同会社 貘</span>
    </a>
    <div class="bar-right">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="gnav">メニュー</button>
    <nav class="gnav" id="gnav" aria-label="サイト内">
      <ul>
        {items.map((it) => (
          <li><a href={it.href} aria-current={current === it.key ? 'page' : undefined}>{it.label}</a></li>
        ))}
        <li><a href={REVERSE_URL} rel="noopener">REVERSE <span aria-hidden="true">↗</span><span class="vh">（外部サイト）</span></a></li>
      </ul>
    </nav>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var b = document.querySelector('.menu-btn'), n = document.getElementById('gnav');
    if (!b || !n) return;
    b.addEventListener('click', function () {
      var o = n.classList.toggle('open');
      b.setAttribute('aria-expanded', o ? 'true' : 'false');
    });
  })();
</script>
