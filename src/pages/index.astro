---
import SysIllust from '../components/SysIllust.astro';
import IpIllust from '../components/IpIllust.astro';
import IslandIllust from '../components/IslandIllust.astro';
import { CLINIC_URL, SHOW_ISLAND, FORM_READY } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cloud from '../components/Cloud.astro';
import FactTable from '../components/FactTable.astro';
import ContactEntry from '../components/ContactEntry.astro';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '合同会社 貘',
  alternateName: 'Baku LLC',
  url: 'https://baku-llc.co.jp/',
  logo: 'https://baku-llc.co.jp/assets/logo_icon.jpg',
  foundingDate: '2026-10',
  email: 'baku@baku-llc.co.jp',
  address: {
    '@type': 'PostalAddress',
    postalCode: '140-0001',
    addressRegion: '東京都',
    addressLocality: '品川区',
    streetAddress: '北品川四丁目11-8 春雨寺1階',
    addressCountry: 'JP',
  },
};
---
<BaseLayout
  title="合同会社 貘 | Baku LLC"
  description={SHOW_ISLAND ? "合同会社 貘は、業務システムの開発、キャラクターなどの知的財産の管理、島の動物診療所の運営を行う会社です。契約、権利の管理、窓口、日々の運営を引き受けます。" : "合同会社 貘は、業務システムの開発と、キャラクターなどの知的財産の管理を行う会社です。契約、権利の管理、窓口、日々の運営を引き受けます。"}
  ogDescription={SHOW_ISLAND ? "システム開発・知的財産の管理・島の動物診療の会社です。" : "システム開発と知的財産の管理の会社です。"}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(orgJsonLd)} />

  <!-- ① 冒頭：紋章ができあがる部分は1回、その後は背景の花びらだけが動き続ける -->
  <div class="hero-wrap">
    <section class="hero" aria-label="オープニング">
      <video id="hero-video" src="/assets/baku_video_final.mp4" autoplay muted playsinline preload="auto" aria-hidden="true"></video>
      <img class="hero-still" src="/assets/hero_still.webp" alt="" aria-hidden="true" />
      <canvas class="hero-petals" aria-hidden="true"></canvas>
      <div class="veil" aria-hidden="true"></div>
    </section>
  </div>

  <!-- ② ステートメント（藍） -->
  <section class="sec sec--1 center" aria-labelledby="statement-h" data-reveal>
    <Cloud side="l" /><Cloud side="r" />
    <div class="container">
      <h1 class="vh">合同会社 貘</h1>
      <h2 class="display rv" id="statement-h">あいだに立って、実務を引き受けます。</h2>
      <p class="lead rv" style="margin:40px auto 0;max-width:30em">システムを必要とする事業者と、それを作る開発者。キャラクターの権利者と、それを使いたい企業。{SHOW_ISLAND && '獣医師の少ない島と、そこへ通う獣医師。'}</p>
      <p class="rv" style="margin:24px auto 0;max-width:30em">そのあいだには、契約、権利の管理、窓口、日々の運営といった実務が生まれます。合同会社 貘は、その実務を引き受けます。それぞれが、本来の仕事に集中できます。</p>
    </div>
  </section>

  <!-- ③ 事業：システム開発（生成りの帯・からくり帳場の絵） -->
  <section class="sec sec--1 paper" id="business" aria-labelledby="biz2-h" data-reveal>
    <div class="container">
      <div class="head-l"><span class="label rv">事業</span></div>
      <div class="grid biz2 rev">
        <div class="txt-col">
          <h3 class="h3 rv" id="biz2-h">システム開発</h3>
          <p class="lead rv">業務を動かすシステムを、作るところから運用まで。</p>
          <p class="rv">業務システム・Web・アプリを必要とする事業者のご相談をお受けしています。開発は提携する開発者が担い、ご相談・契約・導入・お問い合わせの窓口は貘がひとつにまとめます。</p>
          <p class="h4">引き受けること</p>
          <ul class="duties">
            <li><b>開発</b><span>業務システム・Webサイト・アプリの開発</span></li>
            <li><b>自動化</b><span>AIを使った、事務の作業の自動化</span></li>
            <li><b>運用</b><span>使い始めてからの運用と保守、使い方のご相談</span></li>
          </ul>
          <a class="btn" href="/business/02/">システム開発について <span aria-hidden="true">→</span></a>
        </div>
        <div class="fig-col fig-wrap rv-fig">
          <div class="float float--slow"><SysIllust /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ④ 事業：IPライセンス（藍・線画） -->
  <section class="sec sec--1" aria-labelledby="biz-h" data-reveal>
    <div class="container">
      <div class="grid biz2">
        <div class="fig-col fig-wrap rv-fig">
          <div class="float float--slow"><IpIllust /></div>
        </div>
        <div class="txt-col">
          <h3 class="h3 rv" id="biz-h">IPライセンス</h3>
          <p class="lead rv">キャラクターの権利（IP）を、企業が使える形に。</p>
          <p class="rv">権利の管理、使用許諾の契約、ロイヤリティの受け渡しを引き受けます。権利者は本来の活動に専念でき、企業はひとつの窓口で権利を使えます。</p>
          <p class="h4">担うこと</p>
          <ul class="duties">
            <li><b>管理</b><span>商標・著作権の管理と、使い方の決まりの運用</span></li>
            <li><b>使用許諾</b><span>企業からの申し込みの受付と、使用許諾の契約</span></li>
            <li><b>ロイヤリティ</b><span>使用状況の確認と、ロイヤリティの受け渡し</span></li>
          </ul>
          <p class="note rv">現在は準備中です。管理委託・商用利用のご相談は受け付けています。</p>
          <a class="btn" href="/business/01/">IPライセンスについて <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑤ 事業：島の動物診療（生成り・島の絵）。SHOW_ISLAND が false の間は出さない -->
  {SHOW_ISLAND && (
  <section class="sec sec--1 paper" aria-labelledby="biz3-h" data-reveal>
    <div class="container">
      <div class="grid biz2 rev">
        <div class="txt-col">
          <h3 class="h3 rv" id="biz3-h">島の動物診療</h3>
          <p class="lead rv">獣医師の少ない島で、動物の診療が続くように。</p>
          <p class="rv">獣医師が常駐しにくい島の動物診療所の運営を引き受け、島へ通う獣医師・看護師を手配します。予約や記録といった事務は貘がまとめ、獣医師は診療に集中できるようにします。</p>
          <p class="h4">担うこと</p>
          <ul class="duties">
            <li><b>人の手配</b><span>島へ通う獣医師・看護師の、日程の調整と手配</span></li>
            <li><b>予約・問い合わせ</b><span>診療日の予約の受付と、飼い主からの問い合わせへの対応</span></li>
            <li><b>在庫・記録・会計</b><span>薬や物品の発注、診療の記録と会計</span></li>
          </ul>
          <p class="note rv">最初の島は伊豆大島の「うみねこ診療所」です。運営の形を関係者と話し合っています。</p>
          <div class="btn-row">
            <a class="btn" href="/business/03/">島の動物診療について <span aria-hidden="true">→</span></a>
            <a class="btn" href={CLINIC_URL} target="_blank" rel="noopener">うみねこ診療所のサイト <span aria-hidden="true">↗</span><span class="vh">（新しいタブで開きます）</span></a>
          </div>
        </div>
        <div class="fig-col fig-wrap rv-fig">
          <div class="float float--slow"><IslandIllust /></div>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ⑥ 会社の要点（中央が明るい藍・紋章の見切れ） -->
  <section class="sec sec--2 bg-lift" aria-labelledby="co-h" data-reveal>
    <img class="bleed-emblem" data-parallax="0.08" src="/assets/emblem.webp" alt="" aria-hidden="true" width="520" height="520" loading="lazy" />
    <div class="container grid">
      <div style="grid-column:1 / span 7">
        <span class="label rv">会社概要</span>
        <h2 class="h2 rv" id="co-h" style="margin:16px 0 24px">合同会社 貘</h2>
        <p class="rv measure">貘は、悪い夢を食べるとされる想像上の動物です。人や組織が抱えきれないものを引き受ける仕事をしたい、という考えから、この名を付けました。</p>
        <div class="rv" style="margin-top:40px">
          <FactTable rows={[
            ['商号', '合同会社 貘（Baku LLC）'],
            ['設立', '2026年10月'],
            ['所在地', '東京都品川区北品川四丁目11-8 春雨寺1階'],
            ['事業内容', SHOW_ISLAND ? 'システムの開発と提供／知的財産（IP）のライセンス管理／島の動物診療所の運営管理' : 'システムの開発と提供／知的財産（IP）のライセンス管理'],
          ]} caption="会社の要点" />
        </div>
        <a class="btn rv" href="/company/">会社概要へ <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ⑦ お問い合わせ（藍＋青海波） -->
  <ContactEntry heading="まずは、ご相談から。" text={FORM_READY ? "どの事業のご相談も、お問い合わせフォームからお送りください。担当者から、メールでお返事します。" : "どの事業のご相談も、メールでお送りください。担当者から、メールでお返事します。"} />


  <script is:inline>
  /* 冒頭：動画が最初のコマを用意できたら静かに出す */
  (function () {
    var v = document.getElementById('hero-video');
    if (!v) return;
    var ready = function () { v.classList.add('is-ready'); };
    if (v.readyState >= 2) ready();
    else { v.addEventListener('loadeddata', ready, { once: true }); v.addEventListener('canplay', ready, { once: true }); }
  })();
  </script>

  <script is:inline>
  /* 背景の花びらだけを動かし続ける（紋章ができあがる部分は1回だけ）。
     座標は動画の画素（1920×1080）で持ち、画面には動画と同じ写し方（横長は contain・それ以外は cover）で描く。
     紋章の円（中心 960,510・半径 362）の内側には描かない＝花びらは紋章の後ろを通る。
     「動きを止める」では花びらを止めて隠す（静止画は残る）。 */
  (function () {
    var root = document.documentElement;
    var hero = document.querySelector('.hero');
    var v = document.getElementById('hero-video');
    var still = hero && hero.querySelector('.hero-still');
    var cv = hero && hero.querySelector('.hero-petals');
    var cue = hero && hero.querySelector('.hero-cue');
    if (!hero || !v || !still || !cv) return;
    var VW = 1920, VH = 1080, CX = 960, CY = 510, CR = 362;
    function wide() { return hero.clientWidth / hero.clientHeight > VW / VH + 0.01; }
    function layout() { hero.classList.toggle('is-wide', wide()); }
    layout(); addEventListener('resize', layout);
    function off() { return root.dataset.motion === 'off'; }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { still.classList.add('on'); if (cue) cue.classList.add('on'); return; }

    var ctx = cv.getContext('2d');
    var dpr = 1, s = 1, ox = 0, oy = 0;
    function fit() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = hero.clientWidth, h = hero.clientHeight;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
      s = wide() ? Math.min(w / VW, h / VH) : Math.max(w / VW, h / VH);
      ox = (w - VW * s) / 2; oy = (h - VH * s) / 2;
    }
    function rand(a, b) { return a + Math.random() * (b - a); }
    function petal(x, y, first) {
      return { x: x, y: y, vx: first ? -65 : rand(-80, -40), vy: first ? 52 : rand(36, 66),
        sway: rand(10, 26), ph: rand(0, 6.28), fq: rand(.5, 1.1), rot: rand(0, 6.28), vr: rand(-.9, .9), sz: rand(.8, 1.2), a: rand(.55, .85) };
    }
    var petals = [];
    function spawn() { return Math.random() < .6 ? petal(rand(1300, 1980), rand(-40, 600)) : petal(VW + 30, rand(120, 760)); }
    function draw(p, t) {
      var x = p.x + Math.sin(t * p.fq + p.ph) * p.sway;
      ctx.save();
      ctx.translate(x, p.y); ctx.rotate(p.rot + Math.sin(t * .8 + p.ph) * .4);
      ctx.scale(p.sz, p.sz * (0.55 + 0.45 * Math.abs(Math.cos(t * p.fq * 1.4 + p.ph))));
      var g = ctx.createLinearGradient(0, -12, 0, 12);
      g.addColorStop(0, 'rgba(232,170,170,' + p.a + ')');
      g.addColorStop(1, 'rgba(196,128,132,' + (p.a * .9) + ')');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(0, 12); ctx.bezierCurveTo(-9, 5, -8, -9, -2.5, -12); ctx.lineTo(0, -9); ctx.lineTo(2.5, -12); ctx.bezierCurveTo(8, -9, 9, 5, 0, 12);
      ctx.fill(); ctx.restore();
    }
    var running = false, last = 0, visible = true;
    function frame(now) {
      if (!running) return;
      if (off()) { running = false; return; }
      var dt = Math.min((now - last) / 1000, .05); last = now;
      var t = now / 1000;
      ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.setTransform(s * dpr, 0, 0, s * dpr, ox * dpr, oy * dpr);
      ctx.save();
      ctx.beginPath(); ctx.rect(-200, -200, VW + 400, VH + 400); ctx.arc(CX, CY, CR, 0, Math.PI * 2, true); ctx.clip();
      for (var i = 0; i < petals.length; i++) {
        var p = petals[i];
        p.x += p.vx * dt; p.y += p.vy * dt; p.rot += p.vr * dt;
        if (p.x < -60 || p.y > VH + 60) petals[i] = spawn();
        draw(petals[i], t);
      }
      ctx.restore();
      if (visible) requestAnimationFrame(frame); else running = false;
    }
    function start() { if (running || off()) return; running = true; last = performance.now(); requestAnimationFrame(frame); }
    function handoff() {
      if (still.classList.contains('on')) return;
      fit();
      petals = [petal(1736, 545, true)];
      for (var k = 0; k < 6; k++) { var q = spawn(); q.x = rand(80, 1880); q.y = rand(40, 1040); petals.push(q); }
      still.classList.add('on'); cv.classList.add('on'); hero.classList.add('handed');
      if (cue) cue.classList.add('on');
      start();
    }
    // 「動きを止める」が最初から有効なら、動画を流さず最後のコマから始める
    if (off()) { v.pause(); handoff(); }
    v.addEventListener('ended', handoff);
    v.addEventListener('timeupdate', function () { if (v.duration && v.currentTime > v.duration - .08) handoff(); });
    v.addEventListener('error', handoff);
    addEventListener('resize', fit);
    addEventListener('baku:motion', function () { if (off()) { v.pause(); handoff(); } else if (still.classList.contains('on')) start(); });
    new IntersectionObserver(function (es) {
      visible = es[0].isIntersecting;
      if (visible && still.classList.contains('on')) start();
    }).observe(hero);
  })();
  </script>
</BaseLayout>
