---
import BaseLayout from '../layouts/BaseLayout.astro';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '合同会社 貘',
  alternateName: 'Baku LLC',
  url: 'https://baku-llc.co.jp/',
  logo: 'https://baku-llc.co.jp/assets/logo_icon.jpg',
  foundingDate: '2026',
  email: 'baku@baku-llc.co.jp',
};
---
<BaseLayout
  title="合同会社 貘 | Baku LLC"
  description="文化と事業を、つなぐ。合同会社 貘は、IPライセンス・広告代理・監修・イベント・Web/アプリ開発を横断し、想いの種を、事業として社会に届けます。"
  ogDescription="文化と事業を、つなぐ。"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(orgJsonLd)} />

  <a class="skip-link" href="#about">本文へスキップ</a>

  <header class="topbar">
    <div class="mark">BAKU&nbsp;&nbsp;LLC</div>
    <nav aria-label="グローバルナビゲーション">
      <a href="#about">About</a>
      <a href="#mission">Mission</a>
      <a href="#business">Business</a>
      <a href="#company">Company</a>
    </nav>
  </header>

  <main>

  <!-- §1 Hero -->
  <section class="hero" aria-label="Hero">
    <video
      id="hero-video"
      src="/assets/baku_video_final.mp4"
      autoplay muted playsinline preload="auto"
      aria-hidden="true"></video>
    <div class="veil" aria-hidden="true"></div>
    <a class="scroll-cue" href="#about" aria-label="次のセクションへ進む">　 進 む 　</a>
  </section>

  <!-- §2 About -->
  <section id="about" class="about" aria-labelledby="about-heading">
    <span class="anchor">§ 02 — About</span>
    <h2 id="about-heading" class="copy reveal d1">
      <span class="nowrap">文化と事業を、</span><span class="nowrap"><em>つなぐ</em>。</span>
    </h2>
    <p class="sub reveal d3">
      <span class="nowrap">合同会社 貘は、</span><span class="nowrap">知財・流通・監修・</span><span class="nowrap">場づくりを横断し、</span><br class="br-pc" />
      <span class="nowrap">想いの種を、</span><span class="nowrap">事業として</span><span class="nowrap">社会に届けます。</span>
    </p>
  </section>

  <div class="band-divider band-divider--ink" aria-hidden="true">
    <span class="divider"><span>§</span></span>
  </div>

  <!-- §3 Mission -->
  <section id="mission" class="mission ink" aria-labelledby="mission-heading">
    <span class="anchor">§ 03 — Mission</span>
    <div class="reveal"><span class="eyebrow" id="mission-heading">Our Mission</span></div>
    <div class="rule-v reveal d1" aria-hidden="true"></div>

    <div class="lines">
      <p class="reveal d4"><span class="nowrap">私たちは、</span><span class="nowrap">想いを引き受け、</span><span class="nowrap"><em>事業</em>として</span><span class="nowrap">お返しします。</span></p>
    </div>

    <div class="seal reveal d6" aria-hidden="true">貘</div>
  </section>

  <div class="band-divider band-divider--paper" aria-hidden="true">
    <span class="divider"><span>Business</span></span>
  </div>

  <!-- §4 Business 01 -->
  <section id="business" class="biz light" aria-labelledby="biz1-heading">
    <span class="anchor">§ 04 — Business</span>
    <span class="anchor right">01 / 05</span>
    <a class="biz-link" href="/business/01/" aria-label="IPライセンス事業の詳細ページへ">
      <div class="frame">
        <div class="num" aria-hidden="true">壱</div>
        <div class="content">
          <div class="reveal index">— Chapter One —</div>
          <h2 class="reveal d1 en-title" id="biz1-heading">IP License</h2>
          <h3 class="reveal d2 ja-title">I P ライセンス</h3>
          <p class="reveal d3 lead">
            <span class="nowrap">キャラクター・ブランドの</span><span class="nowrap">IPを管理し、</span><span class="nowrap">企業との共創を</span><span class="nowrap">設計します。</span>
          </p>
          <p class="reveal d4 note">
            <span class="nowrap">商標・著作権の管理、</span><span class="nowrap">サブライセンス供与を通じた、</span><span class="nowrap">IPの活用設計。</span>
          </p>
        </div>
      </div>
    </a>
  </section>

  <div class="band-divider band-divider--ink" aria-hidden="true">
    <span class="divider"><span>02</span></span>
  </div>

  <!-- §5 Business 02 -->
  <section class="biz ink" aria-labelledby="biz2-heading">
    <span class="anchor">§ 05 — Business</span>
    <span class="anchor right">02 / 05</span>
    <a class="biz-link" href="/business/02/" aria-label="戦略的広告代理・卸仲介事業の詳細ページへ">
      <div class="frame">
        <div class="num" aria-hidden="true">弐</div>
        <div class="content">
          <div class="reveal index">— Chapter Two —</div>
          <h2 class="reveal d1 en-title" id="biz2-heading">Advertising &amp; Distribution</h2>
          <h3 class="reveal d2 ja-title">戦略的広告代理・卸仲介</h3>
          <p class="reveal d3 lead">
            <span class="nowrap">コンテンツ力で</span><span class="nowrap">「売れる仕組み」を</span><span class="nowrap">設計し、</span><span class="nowrap">動物関連市場に届けます。</span>
          </p>
          <p class="reveal d4 note">
            <span class="nowrap">SNS・専門家コミュニティを</span><span class="nowrap">活用した、</span><span class="nowrap">コンテンツ起点の流通設計。</span>
          </p>
        </div>
      </div>
    </a>
  </section>

  <div class="band-divider band-divider--paper" aria-hidden="true">
    <span class="divider"><span>03</span></span>
  </div>

  <!-- §6 Business 03 -->
  <section class="biz light" aria-labelledby="biz3-heading">
    <span class="anchor">§ 06 — Business</span>
    <span class="anchor right">03 / 05</span>
    <a class="biz-link" href="/business/03/" aria-label="監修・コンサルティング仲介事業の詳細ページへ">
      <div class="frame">
        <div class="num" aria-hidden="true">参</div>
        <div class="content">
          <div class="reveal index">— Chapter Three —</div>
          <h2 class="reveal d1 en-title" id="biz3-heading">Supervision &amp; Consulting</h2>
          <h3 class="reveal d2 ja-title">監修・コンサルティング仲介</h3>
          <p class="reveal d3 lead">
            <span class="nowrap">獣医師・専門家の知見を、</span><span class="nowrap">企業の商品開発へと</span><span class="nowrap">橋渡しします。</span>
          </p>
          <p class="reveal d4 note">
            <span class="nowrap">動物・環境配慮型商品の</span><span class="nowrap">専門監修、</span><span class="nowrap">知見ネットワークの仲介。</span>
          </p>
        </div>
      </div>
    </a>
  </section>

  <div class="band-divider band-divider--ink" aria-hidden="true">
    <span class="divider"><span>04</span></span>
  </div>

  <!-- §7 Business 04 -->
  <section class="biz ink" aria-labelledby="biz4-heading">
    <span class="anchor">§ 07 — Business</span>
    <span class="anchor right">04 / 05</span>
    <a class="biz-link" href="/business/04/" aria-label="イベント事業の詳細ページへ">
      <div class="frame">
        <div class="num" aria-hidden="true">肆</div>
        <div class="content">
          <div class="reveal index">— Chapter Four —</div>
          <h2 class="reveal d1 en-title" id="biz4-heading">Community Events</h2>
          <h3 class="reveal d2 ja-title">イベント事業</h3>
          <p class="reveal d3 lead">
            <span class="nowrap">命と人が出会う場を、</span><span class="nowrap">地域の真ん中に作ります。</span>
          </p>
          <p class="reveal d4 note">
            <span class="nowrap">お寺を拠点とした、</span><span class="nowrap">譲渡会・講演会・</span><span class="nowrap">文化交流イベントの企画運営。</span>
          </p>
        </div>
      </div>
    </a>
  </section>

  <div class="band-divider band-divider--ink" aria-hidden="true">
    <span class="divider"><span>05</span></span>
  </div>

  <!-- §8 Business 05 -->
  <section class="biz light" aria-labelledby="biz5-heading">
    <span class="anchor">§ 08 — Business</span>
    <span class="anchor right">05 / 05</span>
    <a class="biz-link" href="/business/05/" aria-label="Web・アプリ開発事業の詳細ページへ">
      <div class="frame">
        <div class="num" aria-hidden="true">伍</div>
        <div class="content">
          <div class="reveal index">— Chapter Five —</div>
          <h2 class="reveal d1 en-title" id="biz5-heading">Web &amp; App Development</h2>
          <h3 class="reveal d2 ja-title">Web・アプリ開発</h3>
          <p class="reveal d3 lead">
            <span class="nowrap">Webとアプリで、</span><span class="nowrap">事業のデジタル化を支えます。</span>
          </p>
          <p class="reveal d4 note">
            <span class="nowrap">他社・他団体の</span><span class="nowrap">HP・LP制作、</span><span class="nowrap">AI導入支援、</span><span class="nowrap">アプリケーション開発。</span>
          </p>
        </div>
      </div>
    </a>
  </section>

  <div class="band-divider band-divider--paper" aria-hidden="true">
    <span class="divider"><span>Company</span></span>
  </div>

  <!-- §9 Company -->
  <section id="company" class="company" aria-labelledby="company-heading">
    <span class="anchor">§ 09 — Company</span>
    <div class="reveal"><span class="eyebrow">Company Profile</span></div>
    <h2 id="company-heading" class="reveal d1 h-mincho company-title">
      法 人 情 報
    </h2>

    <dl class="grid reveal d2">
      <dt>Name</dt>           <dd>合同会社 貘 ／ Baku LLC</dd>
      <dt>Established</dt>    <dd>2026年</dd>
      <dt>Representative</dt> <dd>代表社員　坂本 和哉</dd>
      <dt>Address</dt>        <dd>日本国内（詳細はお問い合わせください）</dd>
      <dt>Business</dt>       <dd>IPライセンス／広告代理・卸仲介／監修・コンサルティング／イベント事業／Web・アプリケーション開発</dd>
      <dt>Contact</dt>        <dd><a class="contact-link" href="mailto:baku@baku-llc.co.jp">baku@baku-llc.co.jp</a></dd>
    </dl>
  </section>

  </main>

  <!-- §10 Footer -->
  <footer>
    <div class="row">
      <div class="brand">
        貘
        <small>BAKU &nbsp; LLC</small>
      </div>
      <div class="col">
        <h6>Sitemap</h6>
        <a href="#about">About</a>
        <a href="#mission">Mission</a>
        <a href="#business">Business</a>
        <a href="#company">Company</a>
      </div>
      <div class="col">
        <h6>Contact</h6>
        <a href="mailto:baku@baku-llc.co.jp">baku@baku-llc.co.jp</a>
        <p class="muted">For partnership / press inquiries.</p>
      </div>
      <div class="col">
        <h6>Follow</h6>
        <a href="#" aria-disabled="true" tabindex="-1">X &nbsp;— coming soon</a>
        <a href="#" aria-disabled="true" tabindex="-1">Instagram &nbsp;— coming soon</a>
      </div>
    </div>
    <div class="copy">
      <span>© 2026 Baku LLC.&nbsp;&nbsp;All rights reserved.</span>
      <span>合 同 会 社 　 貘</span>
    </div>
  </footer>

  <script is:inline>
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
  })();
  </script>

  <script is:inline>
  /* Hero video: fade in only after the first frame is decoded, so the dark ink
     background is shown during load instead of a stretched poster image. */
  (function () {
    var v = document.getElementById('hero-video');
    if (!v) return;
    var ready = function () { v.classList.add('is-ready'); };
    if (v.readyState >= 2) { ready(); }
    else {
      v.addEventListener('loadeddata', ready, { once: true });
      v.addEventListener('canplay', ready, { once: true });
    }
  })();
  </script>
</BaseLayout>
