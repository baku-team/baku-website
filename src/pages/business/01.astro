---
import { SHOW_ISLAND, FORM_READY } from '../../config';
import IpIllust from '../../components/IpIllust.astro';
import PageBg from '../../components/PageBg.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cloud from '../../components/Cloud.astro';
import FactTable from '../../components/FactTable.astro';
import ContactEntry from '../../components/ContactEntry.astro';
---
<BaseLayout
  title="IPライセンス | 合同会社 貘"
  description="合同会社 貘は、キャラクターの権利を預かり、使いたい企業との契約と、ロイヤリティの受け渡しまでを引き受けます。"
  canonicalPath="/business/01/"
  current="ip"
>
  <section class="sec sec--1 center page-head ov" aria-labelledby="ph" data-reveal style="z-index:2;padding-bottom:0">
    <PageBg kind="ripple" />
    <Cloud side="l" /><Cloud side="r" />
    <div class="container">
      <ol class="crumbs rv" aria-label="現在地"><li><a href="/">ホーム</a></li><li aria-current="page">IPライセンス</li></ol>
      <h1 class="display rv" id="ph">IPライセンス</h1>
      <p class="lead rv">キャラクターの権利（IP）を、企業が使える形に。</p>
      <p class="note rv" style="margin-top:16px">現在は準備中です。管理委託・商用利用のご相談は受け付けています。</p>
      <div class="fig-wrap rv-fig drop-down" style="margin-top:48px">
        <div class="float float--slow"><IpIllust /></div>
      </div>
    </div>
  </section>

  <section class="sec sec--2 paper" aria-label="要点" data-reveal style="padding-top:128px">
    <div class="container grid">
      <div class="summary rv">
        <FactTable rows={[
          ['対象', 'キャラクターの権利者と、それを使いたい企業'],
          ['引き受けること', '権利の管理・使用許諾の契約・ロイヤリティの受け渡し'],
          ['ご相談', FORM_READY ? '<a href="/contact/">お問い合わせフォーム</a>から' : '<a href="/contact/">メール</a>で'],
        ]} caption="IPライセンスの要点" />
      </div>
    </div>
  </section>

  <section class="sec sec--2" aria-labelledby="a1" data-reveal>
    <div class="container">
      <div class="grid row2">
        <div class="a-head"><h2 class="h3 rv" id="a1">権利者と企業のあいだに立つ</h2></div>
        <div class="a-body measure">
          <p class="rv">キャラクターの権利者は、作品を持っていても、自ら商品化やライセンスの事業を行うことが難しい場合があります。</p>
          <p class="rv">合同会社 貘は、権利者から権利の管理を預かり、使いたい企業との契約と、ロイヤリティの受け渡しまでを引き受けます。権利者は本来の活動に専念でき、企業はひとつの窓口で権利を使えます。</p>
          <p class="muted rv">現在は準備中で、権利者との管理委託の取り決めに向けて準備を進めています。取扱いが決まったIPは、このページでお知らせします。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--2 bg-ink2" aria-labelledby="a2" data-reveal>
    <div class="container">
      <div class="head-l"><h2 class="h3 rv" id="a2">貘が担うこと</h2></div>
      <div class="cards">
        <article class="card"><span class="num">01</span><h3>管理</h3><p>商標・著作権の管理と、使い方の決まりの運用。</p></article>
        <article class="card"><span class="num">02</span><h3>使用許諾</h3><p>企業からの申し込みの受付と、使用許諾の契約。</p></article>
        <article class="card"><span class="num">03</span><h3>ロイヤリティ</h3><p>使用状況の確認と、ロイヤリティの受け渡し。</p></article>
      </div>
    </div>
  </section>

  <section class="sec sec--2" aria-label="費用とご相談" data-reveal>
    <div class="container">
      <div class="grid row2">
        <div class="a-head"><h2 class="h3 rv">費用について</h2></div>
        <div class="a-body measure"><p class="rv">ロイヤリティと手数料は、利用の形・期間・販路の規模に応じて、個別にご相談します。</p></div>
      </div>
      <div class="grid row2">
        <div class="a-head"><h2 class="h3 rv">管理委託・商用利用のご相談</h2></div>
        <div class="a-body measure">
          <p class="h4 rv">ご相談時にお知らせいただきたいこと</p>
          <ol class="numlist rv">
            <li>会社名／団体名</li>
            <li>ご担当者名</li>
            <li>連絡先（メールアドレス）</li>
            <li>目的・企画概要（グッズ／メディア展開などの想定）</li>
            <li>時期</li>
          </ol>
          <p class="rv"><a class="btn btn--primary" href="/contact/">{FORM_READY ? 'お問い合わせフォームへ' : 'お問い合わせへ'} <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
      <nav class="pager rule-top" style="margin-top:64px;padding-top:24px" aria-label="ページ移動">
        <a href="/business/02/">← 前の事業　システム開発</a>
        {SHOW_ISLAND && <a class="btn" style="margin-top:0" href="/business/03/">次の事業　島の動物診療 <span aria-hidden="true">→</span></a>}
      </nav>
    </div>
  </section>

  <ContactEntry heading="管理委託・商用利用のご相談を、お受けしています。" text="上の項目を、わかる範囲でお知らせください。" />
</BaseLayout>
