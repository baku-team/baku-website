---
import SysIllust from '../../components/SysIllust.astro';
import PageBg from '../../components/PageBg.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cloud from '../../components/Cloud.astro';
import FactTable from '../../components/FactTable.astro';
import ContactEntry from '../../components/ContactEntry.astro';
import { REVERSE_URL, FORM_READY } from '../../config';
---
<BaseLayout
  title="システム開発 | 合同会社 貘"
  description="合同会社 貘は、業務システム・Web・アプリの開発と、使い始めてからの運用を引き受けます。業務AI「REVERSE」を開発・提供しています。"
  canonicalPath="/business/02/"
  current="system"
>
  <section class="sec sec--1 center page-head" aria-labelledby="ph" data-reveal>
    <PageBg kind="dots" />
    <Cloud side="l" /><Cloud side="r" />
    <div class="container">
      <ol class="crumbs rv" aria-label="現在地"><li><a href="/">ホーム</a></li><li aria-current="page">システム開発</li></ol>
      <h1 class="display rv" id="ph">システム開発</h1>
      <p class="lead rv">業務を動かすシステムを、作るところから運用まで。</p>
      <p class="rv" style="margin-top:16px">業務システム・Web・アプリを必要とする事業者のご相談をお受けしています。</p>
    </div>
  </section>

  <!-- 要点の表（生成り）＋からくり帳場の絵 -->
  <section class="sec sec--2 paper ov" aria-label="要点" data-reveal>
    <div class="container grid" style="align-items:center;row-gap:32px">
      <div class="rv" style="grid-column:1 / span 7">
        <FactTable rows={[
          ['対象', '業務システム・Web・アプリを必要とする事業者'],
          ['引き受けること', '開発・AIによる事務作業の自動化・運用と保守'],
          ['自社サービス', `業務AI「REVERSE」（<a href="${REVERSE_URL}" rel="noopener">製品サイトへ ↗</a>）`],
          ['ご相談', FORM_READY ? '<a href="/contact/">お問い合わせフォーム</a>から' : '<a href="/contact/">メール</a>で'],
        ]} caption="システム開発の要点" />
      </div>
      <div class="fig-wrap rv-fig" style="grid-column:8 / span 5">
        <div class="float float--slow"><SysIllust width={420} /></div>
      </div>
    </div>
  </section>

  <section class="sec sec--2" aria-label="内容" data-reveal>
    <div class="container">
      <div class="grid row2">
        <div class="a-head"><h2 class="h3 rv">開発者と事業者のあいだに立つ</h2></div>
        <div class="a-body measure">
          <p class="rv">業務を動かすシステムを、作るところから、使い始めたあとの運用まで引き受けます。開発は提携する開発者が担い、合同会社 貘は、ご相談・契約・導入・お問い合わせの窓口をひとつにまとめます。</p>
          <p class="rv">自社では、業務AI「REVERSE」を開発し、提供しています。開発から運用までを自分たちで続けている経験を、ご相談にも生かします。</p>
          <p class="muted rv">運営するメンバーは獣医師です。動物病院の院内の業務（総務・労務・連絡）にも通じています。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--2 bg-ink2" aria-labelledby="take-h" data-reveal>
    <div class="container">
      <div class="head-l"><h2 class="h3 rv" id="take-h">引き受けること</h2></div>
      <div class="cards">
        <article class="card"><span class="num">01</span><h3>開発</h3><p>業務システム・Webサイト・アプリを作ります。</p></article>
        <article class="card"><span class="num">02</span><h3>自動化</h3><p>AIを使って、事務の作業を自動にします。</p></article>
        <article class="card"><span class="num">03</span><h3>運用</h3><p>使い始めてからの運用と保守、使い方のご相談を続けます。</p></article>
      </div>
      <p class="rv" style="margin-top:32px">作る前に、いまの業務の流れと困っていることを伺います。</p>
    </div>
  </section>

  <section class="sec sec--2" aria-labelledby="flow-h" data-reveal>
    <div class="container">
      <div class="head-l"><h2 class="h3 rv" id="flow-h">進め方</h2></div>
      <ol class="flow">
        <li><span class="n">1</span><b>ご相談</b><span>いまの業務と、困っていること</span></li>
        <li><span class="n">2</span><b>ご提案</b><span>作るものと費用</span></li>
        <li><span class="n">3</span><b>契約</b><span>内容と費用を決めて契約</span></li>
        <li><span class="n">4</span><b>開発</b><span>途中で確かめながら作る</span></li>
        <li><span class="n">5</span><b>運用</b><span>引き渡しと、その後の運用</span></li>
      </ol>
      <p class="note rv" style="margin-top:24px">費用は、作るものの内容と規模に応じてお見積りします。</p>
    </div>
  </section>

  <section class="sec sec--3 rule-top" aria-labelledby="rv-h" data-reveal>
    <div class="container">
      <div class="grid row2">
        <div class="a-head"><h2 class="h3 rv" id="rv-h">自社のサービス</h2></div>
        <div class="a-body measure">
          <p class="rv">業務AI「REVERSE」は、請求書の作成、予定の登録、議事録の作成など、事務の雑務をAIが引き受けるサービスです。料金・使い方・お申し込みは、製品サイトでご案内しています。</p>
          <p class="rv"><a class="btn" href={REVERSE_URL} rel="noopener">REVERSE 製品サイトへ <span aria-hidden="true">↗</span><span class="vh">（外部サイト）</span></a></p>
        </div>
      </div>
      <nav class="pager rule-top" style="margin-top:64px;padding-top:24px" aria-label="ページ移動">
        <a href="/">← トップへ</a>
        <a class="btn" style="margin-top:0" href="/business/01/">次の事業　IPライセンス <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>

  <ContactEntry heading="システム開発のご相談を、お受けしています。" text="いまの業務と、困っていることを、わかる範囲でお知らせください。" />
</BaseLayout>
